NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Stripe platform account (use a restricted key rk_… in production). Webhook: Connect endpoint → /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect → Settings → OAuth: client id (ca_…) + redirect URI <APP_URL>/api/integrations/stripe/callback
STRIPE_CLIENT_ID=
# roots' fee per paid order: percent of the total + fixed cents (both default 0)
PLATFORM_FEE_PERCENT=
PLATFORM_FEE_FIXED_CENTS=
# Event hub: protects /api/cron/events (any long random string)
CRON_SECRET=
# Telegram: orgs connect their own bots; set 1 locally (no public URL) to poll instead of webhooks
TELEGRAM_POLLING=
# SumUp OAuth app (redirect URI <APP_URL>/api/integrations/sumup/callback; online payments need the "payments" scope)
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
# roots' own email account (orgs can connect their own Resend/Brevo in Settings → Integrations).
# EMAIL_FROM: a verified sender on your domain, e.g. "roots <hallo@your-domain>".
# EMAIL_PROVIDER: roots' own mails (logins, invites, notifications): resend | brevo (empty = the first with a key).
# EMAIL_PROVIDER_ORGS: mails of orgs WITHOUT their own provider (tickets, campaigns …): resend | brevo.
#   Empty = no fallback: orgs must connect their own email provider.
EMAIL_FROM=
EMAIL_PROVIDER=
EMAIL_PROVIDER_ORGS=
RESEND_API_KEY=
# Resend webhook for roots' own account (delivery status): <APP_URL>/api/webhooks/resend, signing secret whsec_…
RESEND_WEBHOOK_SECRET=
BREVO_API_KEY=
# Brevo transactional webhook for roots' own account: <APP_URL>/api/webhooks/brevo?k=<this token> (long random string)
BREVO_WEBHOOK_TOKEN=
# Own domains for orgs' public pages (Settings → Domain): Vercel token (team scope) + project/team ids (.vercel/project.json)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Signs MCP/Sprout confirm tokens and upload links (default: SUPABASE_SECRET_KEY)
MCP_CONFIRM_SECRET=
# "false" switches the MCP endpoint off
MCP_ENABLED=
