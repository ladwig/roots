{
  "name": "roots",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "set -a && . ./.env.local && supabase db push --db-url \"$DATABASE_URL\"",
    "db:test": "set -a && . ./.env.local && supabase db query --db-url \"$DATABASE_URL\" -f supabase/tests/isolation.sql 2>&1 | grep -q \"all checks passed\" && echo \"isolation: all checks passed\" || (supabase db query --db-url \"$DATABASE_URL\" -f supabase/tests/isolation.sql; exit 1)",
    "db:types": "set -a && . ./.env.local && supabase gen types typescript --db-url \"$DATABASE_URL\" --schema public > src/lib/supabase/types.ts",
    "test": "node --test --no-warnings 'src/**/*.test.mjs'",
    "admin:grant": "sh scripts/grant-admin.sh",
    "worker": "sh scripts/worker.sh",
    "worker:schedule": "sh scripts/schedule-worker.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "stripe": "^22.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
